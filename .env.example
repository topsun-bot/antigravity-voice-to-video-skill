# ==============================================================================
# Antigravity Voice-to-Video Studio — Cinematic Pipeline Configuration
# 复制本文件为 .env 并填入你使用的凭据（默认优先使用 Google 生态）
# ==============================================================================

# 视频引擎优先级模式：
# auto (默认: google_veo_gemini -> google_veo_vertex -> google_flow -> volcengine_seedance -> kling -> runway -> kenburns)
# 也可显式指定: google_veo_gemini | google_veo_vertex | google_flow | volcengine_seedance | kling | runway | kenburns
GOOGLE_VIDEO_BACKEND=auto

# ------------------------------------------------------------------------------
# [优先级 1] Google Gemini API (Veo 3.1 + Imagen 生图，一套 Key 全自动最稳)
# 获取地址: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# 默认 Veo 模型档位（按需修改）
VEO_MODEL_LITE=veo-3.1-lite-generate-preview
VEO_MODEL_FAST=veo-3.1-fast-generate-preview
VEO_MODEL_QUALITY=veo-3.1-generate-preview

# 解说类视频建议保持 false（后期统一配旁白和 BGM，可省 30%-50% 视频生成成本）
VIDEO_ENABLE_AUDIO=false

# 并发提交给视频 API 的最大任务数（建议 3-6）
MAX_CONCURRENCY=4

# ------------------------------------------------------------------------------
# [优先级 1B] Google Cloud Vertex AI (企业对公账单 / gcloud auth)
# 若未设置 GEMINI_API_KEY 但已配置 gcloud 登录，可填写以下两项走 Vertex AI
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ------------------------------------------------------------------------------
# [备用视频引擎] 国内即梦/火山方舟 Seedance、可灵 Kling、Runway（按需选填）
# ------------------------------------------------------------------------------
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_SEEDANCE_MODEL=doubao-seedance-1-0-pro-250528

KLING_ACCESS_KEY=
KLING_SECRET_KEY=

RUNWAYML_API_SECRET=

# ------------------------------------------------------------------------------
# [可选：老板原声克隆 / 高品质配音]
# 不填则默认使用免费 edge-tts 中文配音
# ------------------------------------------------------------------------------
TTS_PROVIDER=edge_tts
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
